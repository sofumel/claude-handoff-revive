# Force LF for shell scripts so they run on Linux/macOS/Git-Bash even when
# the repo is cloned on Windows with autocrlf=true.
*.sh        text eol=lf
*.bash      text eol=lf

# PowerShell scripts are LF too (the plugin directory scanner rejects eol=crlf).
*.ps1       text eol=lf

# Markdown / JSON / config: normalize to LF (cross-platform compatible).
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Plain-text data files (e.g. lib/secret-patterns.txt) must stay LF: the bash
# scripts read them line-by-line, and a stray CRLF would smuggle a trailing
# \r into each value (silently breaking secret detection on Windows clones).
*.txt       text eol=lf

# Binary files (none currently, but future-proof).
*.png       binary
*.jpg       binary
*.gif       binary
